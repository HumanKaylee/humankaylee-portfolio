---
import type { CollectionEntry } from "astro:content";

import AudienceChips from "./AudienceChips.astro";

type Props = {
	project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { data } = project;
---

<article class="project-card" id={data.slug}>
	<p class="project-category">{data.category}</p>
	<h2>{data.name}</h2>
	<p>{data.summary}</p>
	<AudienceChips
		audiences={data.bestFor}
		label={`Best for ${data.name}`}
	/>
	<p class="proof-line">{data.proof}</p>
	<a
		data-touch-target="true"
		href={`/projects/${data.slug}/`}
		aria-label={`View project detail for ${data.name}`}
	>
		View project detail for {data.name}
	</a>
</article>
