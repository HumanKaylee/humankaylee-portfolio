---
type Props = {
	id: string;
	title: string;
	wide?: boolean;
};

const { id, title, wide = false } = Astro.props;
---

<section
	class:list={["work-case-section", { "work-case-section--wide": wide }]}
	aria-labelledby={id}
>
	<h2 id={id}>{title}</h2>
	<div class="work-case-section__body">
		<slot />
	</div>
</section>

<style>
	.work-case-section {
		display: grid;
		grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(2rem, 5vw, 6rem);
		border-top: 1px solid var(--line);
		padding-block: var(--space-6);
	}

	.work-case-section h2 {
		font-size: clamp(1.8rem, 3.6vw, 3.5rem);
	}

	.work-case-section__body {
		display: grid;
		min-width: 0;
		gap: var(--space-4);
		font-size: clamp(1rem, 1.6vw, 1.18rem);
	}

	.work-case-section__body :global(p),
	.work-case-section__body :global(ul),
	.work-case-section__body :global(ol),
	.work-case-section__body :global(dl) {
		max-width: var(--reading-max);
	}

	.work-case-section__body :global(ul),
	.work-case-section__body :global(ol) {
		margin: 0;
		padding-left: 1.25rem;
	}

	.work-case-section__body :global(li + li) {
		margin-top: var(--space-2);
	}

	.work-case-section--wide {
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-4);
	}

	@media (max-width: 48rem) {
		.work-case-section {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-4);
		}
	}
</style>
