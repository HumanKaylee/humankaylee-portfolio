---
type Props = {
	title: string;
	slug: string;
	discipline: string;
};

const { title, slug, discipline } = Astro.props;
---

<nav class="next-work" aria-label="Next project">
	<p>
		<span>Next project</span>
		<span>{discipline}</span>
	</p>
	<a
		data-touch-target="true"
		href={`/work/${slug}/`}
		aria-label={`Next project: ${title}`}
	>
		{title}<span aria-hidden="true"> →</span>
	</a>
</nav>

<style>
	.next-work {
		display: grid;
		gap: var(--space-4);
		border-block: 1px solid var(--line);
		padding-block: var(--space-6);
	}

	.next-work p {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2);
		color: var(--color-muted);
		font-family: var(--font-evidence);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.next-work a {
		justify-content: space-between;
		font-size: clamp(2rem, 6vw, 5.5rem);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: -0.045em;
	}
</style>
