<div class="reading-progress" data-reading-progress aria-hidden="true">
	<span data-reading-progress-value></span>
</div>

<script>
	const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
	const value = progress?.querySelector<HTMLElement>(
		"[data-reading-progress-value]",
	);

	if (progress && value) {
		const update = () => {
			const maximum = document.documentElement.scrollHeight - window.innerHeight;
			const percent = maximum <= 0 ? 100 : (window.scrollY / maximum) * 100;
			value.style.width = `${Math.min(100, Math.max(1, percent))}%`;
		};

		update();
		addEventListener("scroll", update, { passive: true });
		addEventListener("resize", update, { passive: true });
	}
</script>

<style>
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		z-index: calc(var(--z-header) + 1);
		width: 100%;
		height: 0.2rem;
		pointer-events: none;
	}

	.reading-progress span {
		display: block;
		width: 1%;
		height: 100%;
		background: var(--color-signal);
		transition: width var(--motion-fast) linear;
	}

	@media (prefers-reduced-motion: reduce) {
		.reading-progress {
			display: none;
		}
	}
</style>
