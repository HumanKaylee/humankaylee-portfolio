---
const fallbackEmail = "contact-pending@humankaylee.example";
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "";
---

<article class="paper-panel contact-panel">
	<p class="eyebrow">API-enhanced fallback</p>
	<h2>Start with the public contact path.</h2>
	<p>
		The form attempts the Rust API when JavaScript is available. The mailto
		fallback stays visible, and typed text remains in the form if the API is
		down, disabled, or returns validation feedback.
	</p>

	<form
		class="contact-form"
		data-api-base={apiBaseUrl}
		action={`mailto:${fallbackEmail}`}
		method="post"
		enctype="text/plain"
	>
		<label>
			<span>Your name</span>
			<input name="name" type="text" autocomplete="name" required />
		</label>
		<label>
			<span>Email address</span>
			<input name="email" type="email" autocomplete="email" required />
		</label>
		<label>
			<span>Subject</span>
			<input
				name="subject"
				type="text"
				value="Portfolio inquiry"
				autocomplete="off"
				required
			/>
		</label>
		<label>
			<span>Message</span>
			<textarea name="message" rows="7" minlength="12" required></textarea>
		</label>
		<label class="honeypot-field">
			<span>Company</span>
			<input name="company" type="text" tabindex="-1" autocomplete="off" />
		</label>
		<button type="submit">Send message</button>
		<p class="contact-status" role="status" aria-live="polite">
			Use the email link below if the API is unavailable. This mailto fallback
			remains visible; the form can also try the Rust API enhancement when
			JavaScript is available.
		</p>
	</form>

	<a
		class="contact-link"
		data-touch-target="true"
		href={`mailto:${fallbackEmail}`}
	>
		{fallbackEmail}
	</a>
</article>

<script>
	const form = document.querySelector<HTMLFormElement>(".contact-form");
	const apiUnavailableMessage =
		"API unavailable. Your message is still in the form. Use the email link below if the API is unavailable.";

	function contactEndpoint(apiBase: string) {
		const trimmed = apiBase.trim().replace(/\/$/, "");
		return `${trimmed}/api/contact`;
	}

	async function responseMessage(response: Response) {
		if (!response.ok && response.status !== 400) {
			return apiUnavailableMessage;
		}

		try {
			const payload = await response.json();
			return (
				payload.message ??
				payload.error?.message ??
				"The contact API returned an unexpected response."
			);
		} catch {
			return "The contact API returned an unexpected response.";
		}
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		const status = form.querySelector<HTMLElement>("[role='status']");
		const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
		const data = new FormData(form);
		const payload = {
			name: String(data.get("name") ?? ""),
			email: String(data.get("email") ?? ""),
			subject: String(data.get("subject") ?? ""),
			message: String(data.get("message") ?? ""),
			company: String(data.get("company") ?? ""),
		};

		submit?.setAttribute("disabled", "true");
		if (status) {
			status.textContent = "Sending through the Rust API enhancement...";
		}

		try {
			const response = await fetch(contactEndpoint(form.dataset.apiBase ?? ""), {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify(payload),
			});
			const message = await responseMessage(response);

			if (status) {
				status.textContent = response.ok
					? message
					: message === apiUnavailableMessage
						? message
						: `${message} The mailto fallback remains available below.`;
			}
		} catch {
			if (status) {
				status.textContent = apiUnavailableMessage;
			}
		} finally {
			submit?.removeAttribute("disabled");
		}
	});
</script>
