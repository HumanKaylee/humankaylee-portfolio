---
const fallbackEmail = "josephpoznanski@gmail.com";
---

<article class="paper-panel contact-panel">
	<h2>Compose a focused note.</h2>
	<p>
		This composer opens your email app with the fields below. Nothing is submitted
		to or stored by this website.
	</p>

	<form
		class="contact-form"
		data-fallback-email={fallbackEmail}
		action={`mailto:${fallbackEmail}`}
		method="get"
	>
		<label>
			<span>Your name</span>
			<input name="name" type="text" autocomplete="name" required />
		</label>
		<label>
			<span>Email address</span>
			<input name="email" type="email" autocomplete="email" required />
		</label>
		<label>
			<span>Subject</span>
			<input
				name="subject"
				type="text"
				value="Portfolio inquiry"
				autocomplete="off"
				required
			/>
		</label>
		<label>
			<span>Message</span>
			<textarea name="message" rows="7" minlength="12" required></textarea>
		</label>
		<label class="honeypot-field">
			<span>Company</span>
			<input name="company" type="text" tabindex="-1" autocomplete="off" />
		</label>
		<button type="submit">Open email draft</button>
		<p class="contact-status" role="status" aria-live="polite">
			Nothing is sent or stored by this site. Your email app handles delivery.
		</p>
	</form>

	<a
		class="contact-link"
		data-touch-target="true"
		href={`mailto:${fallbackEmail}`}
	>
		{fallbackEmail}
	</a>
</article>

<script>
	const form = document.querySelector<HTMLFormElement>(".contact-form");

	form?.addEventListener("submit", () => {
		const status = form.querySelector<HTMLElement>("[role='status']");
		const data = new FormData(form);
		const name = String(data.get("name") ?? "").trim();
		const email = String(data.get("email") ?? "").trim();
		const subject = String(data.get("subject") ?? "Portfolio inquiry").trim();
		const message = String(data.get("message") ?? "").trim();
		const body = `${message}\n\nFrom: ${name} (${email})`;
		const fallbackEmail = form.dataset.fallbackEmail ?? "josephpoznanski@gmail.com";
		const mailto = `mailto:${fallbackEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

		if (status) {
			status.textContent = "Opening your email app. Nothing was sent or stored by this site.";
		}
		form.action = mailto;
	});
</script>
