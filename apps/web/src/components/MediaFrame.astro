---
import type { WorkMedia } from "../lib/contracts/work";
import MotionLoop from "./MotionLoop.astro";

type Props = {
	media: WorkMedia;
	playback?: boolean;
	posterSizes?: string;
};

const {
	media,
	playback = false,
	posterSizes = "(max-width: 760px) 100vw, 50vw",
} = Astro.props;
const responsivePosterSources = media.responsivePosterSources
	?.slice()
	.sort((left, right) => left.width - right.width);
const responsivePosterSrcset = responsivePosterSources
	?.map((source) => `${source.src} ${source.width}w`)
	.join(", ");
const nativePoster = responsivePosterSources?.[0]?.src ?? media.poster;
---

<figure class="media-frame" data-media-kind={media.kind}>
	{
		media.kind === "video" && !playback && media.loop ? (
			<MotionLoop loop={media.loop} />
		) : media.kind === "video" && !playback ? (
			<picture class="media-poster" data-video-poster>
				{responsivePosterSrcset ? (
					<source
						type="image/webp"
						srcset={responsivePosterSrcset}
						sizes={posterSizes}
					/>
				) : null}
				<img
					src={media.poster}
					width={media.width}
					height={media.height}
					alt={media.alt}
				/>
			</picture>
		) : media.kind === "video" ? (
			<>
				<div class="media-playback" data-media-playback data-video-state="poster">
					{responsivePosterSrcset ? (
						<picture
							class="media-poster media-playback__poster"
							data-video-poster
							aria-hidden="true"
						>
							<source
								type="image/webp"
								srcset={responsivePosterSrcset}
								sizes={posterSizes}
							/>
							<img
								src={media.poster}
								width={media.width}
								height={media.height}
								alt=""
							/>
						</picture>
					) : null}
					<video
						controls
						preload="none"
						poster={nativePoster}
						width={media.width}
						height={media.height}
						aria-label={media.alt}
					>
						<source src={media.src} type="video/mp4" />
					</video>
				</div>
				<noscript
					set:html={"<style>.media-playback__poster{position:static!important;inset:auto!important}.media-playback video{display:none!important}</style>"}
				/>
				<a class="media-fallback" data-touch-target="true" href={media.src}>
					Open the project video
				</a>
			</>
		) : media.kind === "image" ? (
			<img
				src={media.src}
				width={media.width}
				height={media.height}
				alt={media.alt}
				loading="lazy"
			/>
		) : (
			<slot />
		)
	}
	<figcaption>{media.caption}</figcaption>
</figure>

<script>
	for (const root of document.querySelectorAll<HTMLElement>(
		"[data-media-playback]",
	)) {
		if (root.dataset.playbackReady === "true") continue;
		root.dataset.playbackReady = "true";
		const video = root.querySelector<HTMLVideoElement>("video");
		video?.addEventListener("playing", () => {
			root.dataset.videoState = "playing";
		});
	}
</script>

<style>
	.media-frame {
		display: grid;
		min-width: 0;
		margin: 0;
		gap: 0;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-media);
		background: var(--color-media);
	}

	.media-frame :global(picture),
	.media-frame :global(img),
	.media-frame :global(video) {
		width: 100%;
		height: auto;
	}

	.media-frame :global(img),
	.media-frame :global(video) {
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.media-playback {
		position: relative;
	}

	.media-playback__poster {
		position: absolute;
		inset: 0 0 2.75rem;
		z-index: 1;
		display: block;
		overflow: hidden;
		pointer-events: none;
	}

	.media-playback__poster img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.media-playback[data-video-state="playing"] .media-playback__poster {
		display: none;
	}

	.media-frame figcaption {
		border-top: 1px solid var(--line);
		padding: var(--space-2) var(--space-3);
		color: var(--color-muted);
		font-family: var(--font-evidence);
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.media-fallback {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--space-3);
		font-weight: 700;
	}
</style>
