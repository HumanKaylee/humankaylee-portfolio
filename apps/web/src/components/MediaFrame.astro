---
import type { WorkMedia } from "../lib/contracts/work";
import MotionLoop from "./MotionLoop.astro";

type Props = {
	media: WorkMedia;
	playback?: boolean;
};

const { media, playback = false } = Astro.props;
const responsivePosterSrcset = media.responsivePosterSources
	?.slice()
	.sort((left, right) => left.width - right.width)
	.map((source) => `${source.src} ${source.width}w`)
	.join(", ");
---

<figure class="media-frame" data-media-kind={media.kind}>
	{
		media.kind === "video" && !playback && media.loop ? (
			<MotionLoop loop={media.loop} />
		) : media.kind === "video" && !playback ? (
			<picture class="media-poster" data-video-poster>
				{responsivePosterSrcset ? (
					<source
						type="image/webp"
						srcset={responsivePosterSrcset}
						sizes="(max-width: 760px) 100vw, 50vw"
					/>
				) : null}
				<img
					src={media.poster}
					width={media.width}
					height={media.height}
					alt={media.alt}
				/>
			</picture>
		) : media.kind === "video" ? (
			<>
				<video
					controls
					preload="none"
					poster={media.poster}
					width={media.width}
					height={media.height}
					aria-label={media.alt}
				>
					<source src={media.src} type="video/mp4" />
				</video>
				<a class="media-fallback" data-touch-target="true" href={media.src}>
					Open the simulation video
				</a>
			</>
		) : media.kind === "image" ? (
			<img
				src={media.src}
				width={media.width}
				height={media.height}
				alt={media.alt}
				loading="lazy"
			/>
		) : (
			<slot />
		)
	}
	<figcaption>{media.caption}</figcaption>
</figure>

<style>
	.media-frame {
		display: grid;
		min-width: 0;
		margin: 0;
		gap: 0;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-media);
		background: var(--color-media);
	}

	.media-frame :global(picture),
	.media-frame :global(img),
	.media-frame :global(video) {
		width: 100%;
		height: auto;
	}

	.media-frame :global(img),
	.media-frame :global(video) {
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.media-frame figcaption {
		border-top: 1px solid var(--line);
		padding: var(--space-2) var(--space-3);
		color: var(--color-muted);
		font-family: var(--font-evidence);
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.media-fallback {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--space-3);
		font-weight: 700;
	}
</style>
