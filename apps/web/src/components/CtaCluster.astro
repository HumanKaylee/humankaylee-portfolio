---
import type { ShellLink } from "../lib/home-scaffold";

type Props = {
	items: readonly ShellLink[];
};

const { items } = Astro.props;
---

<nav class="cta-cluster" aria-label="Primary calls to action">
	{
		items.map((item, index) => (
			<a
				class:list={["cta-card", index === 0 && "cta-card-primary"]}
				data-touch-target="true"
				href={item.href}
			>
				<span>{item.eyebrow}</span>
				<strong>{item.label}</strong>
			</a>
		))
	}
</nav>
