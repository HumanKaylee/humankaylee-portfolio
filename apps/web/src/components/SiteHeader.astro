---
import type { ShellLink } from "../lib/home-scaffold";

type Props = {
	nav: readonly ShellLink[];
};

const { nav } = Astro.props;
const currentPath = Astro.url.pathname;

function isCurrentRoute(href: string) {
	if (href === "/") {
		return currentPath === href;
	}

	if (href === "/projects/" && currentPath.startsWith("/case-studies/")) {
		return true;
	}

	return currentPath === href.slice(0, -1) || currentPath.startsWith(href);
}
---

<header class="site-header">
	<a class="brand-lockup" href="/" aria-label="Joe Poznanski home">
		<span class="brand-mark" aria-hidden="true">JP</span>
		<span>
			<span class="brand-title">Joe Poznanski</span>
			<span class="brand-subtitle">Systems Atelier</span>
		</span>
	</a>
	<nav class="primary-nav" aria-label="Primary navigation">
		{
			nav.map((item) => (
				<a
					aria-current={isCurrentRoute(item.href) ? "page" : undefined}
					data-touch-target="true"
					href={item.href}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>
