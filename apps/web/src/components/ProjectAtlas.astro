---
import type { CollectionEntry } from "astro:content";

import AudienceChips from "./AudienceChips.astro";

type ProjectEntry = CollectionEntry<"projects">;

type Props = {
	projects: readonly ProjectEntry[];
};

const { projects } = Astro.props;
const atlasCategories = [
	"AI",
	"automation",
	"infrastructure",
	"backend",
	"creative web",
	"operations",
] as const;
const constellationLayout = [
	{ category: "AI", x: 18, y: 24 },
	{ category: "automation", x: 45, y: 16 },
	{ category: "infrastructure", x: 72, y: 28 },
	{ category: "backend", x: 24, y: 72 },
	{ category: "creative web", x: 68, y: 48 },
	{ category: "operations", x: 28, y: 52 },
] as const;
const categoryCoordinates = new Map(
	constellationLayout.map((cluster) => [cluster.category, cluster]),
);
const constellationNodeOffsets = [
	{ x: -11, y: 11 },
	{ x: 10, y: -8 },
	{ x: -8, y: -10 },
	{ x: 12, y: 9 },
] as const;

function categoryId(category: string) {
	return `atlas-${category.replaceAll(" ", "-")}`;
}

function projectsForCategory(category: string) {
	return projects.filter((project) => project.data.category === category);
}

const populatedConstellationLayout = constellationLayout.filter(
	(cluster) => projectsForCategory(cluster.category).length > 0,
);
const constellationPath = populatedConstellationLayout
	.map((cluster) => `${cluster.x} ${cluster.y}`)
	.join(" L ");

function constellationNodePosition(project: ProjectEntry) {
	const cluster = categoryCoordinates.get(project.data.category) ?? {
		x: 50,
		y: 50,
	};
	const categoryProjects = projectsForCategory(project.data.category);
	const categoryIndex = categoryProjects.findIndex(
		(entry) => entry.data.slug === project.data.slug,
	);
	const offset =
		categoryProjects.length === 1
			? { x: 0, y: 12 }
			: constellationNodeOffsets[
					Math.max(categoryIndex, 0) % constellationNodeOffsets.length
				];

	return `--x: ${cluster.x + offset.x}%; --y: ${cluster.y + offset.y}%;`;
}
---

<section
	class="project-atlas-shell"
	aria-labelledby="project-atlas-title"
>
	<header class="page-header">
		<p class="section-kicker">Capability index</p>
		<h2 id="project-atlas-title">Four projects, two capability clusters.</h2>
		<p class="body-copy">
			Scan the evidence by capability or open a project directly. The desktop
			constellation and the compact index point to the same detail pages.
		</p>
	</header>

	<nav class="atlas-filter-nav" aria-label="Project atlas filters">
		{
			atlasCategories.filter((cat) => projectsForCategory(cat).length > 0).map((category) => {
				const count = projectsForCategory(category).length;

				return (
					<a data-touch-target="true" href={`#${categoryId(category)}`}>
						<span>{category}</span>
						<strong>{count}</strong>
					</a>
				);
			})
		}
	</nav>

	<section
		class="project-constellation"
		aria-label="Desktop project constellation"
		data-project-constellation
	>
		<header>
			<p class="eyebrow">Visual index</p>
			<h3>Project constellation.</h3>
			<p>
				Only capabilities backed by public project evidence appear. Each node opens
				a complete project route.
			</p>
		</header>

		<div class="constellation-stage" aria-label="Capability clusters">
			<svg
				class="constellation-lines"
				viewBox="0 0 100 100"
				role="img"
				aria-label="Constellation paths connecting project capability clusters"
			>
				{constellationPath && <path d={`M ${constellationPath}`} />}
			</svg>
			{
				populatedConstellationLayout.map((cluster) => (
					<span
						class="constellation-cluster-label"
						data-constellation-cluster={cluster.category}
						style={`--x: ${cluster.x}%; --y: ${cluster.y}%;`}
					>
						{cluster.category}
					</span>
				))
			}
			{
				projects.map((project) => (
					<a
						class="constellation-node"
						data-constellation-node
						data-category={project.data.category}
						style={constellationNodePosition(project)}
						href={`/projects/${project.data.slug}/`}
						aria-label={`View project detail for ${project.data.name}`}
					>
						<span>{project.data.name}</span>
					</a>
				))
			}
		</div>
	</section>

	<div class="atlas-category-grid">
		{
			atlasCategories.filter((cat) => projectsForCategory(cat).length > 0).map((category) => {
				const categoryProjects = projectsForCategory(category);

				return (
					<section
						class="atlas-category-panel"
						id={categoryId(category)}
						aria-labelledby={`${categoryId(category)}-title`}
					>
						<p class="project-category">{category}</p>
						<h3 id={`${categoryId(category)}-title`}>
							{categoryProjects.length > 0
								? `${categoryProjects.length} project${
										categoryProjects.length === 1 ? "" : "s"
									}`
								: "No public node yet"}
						</h3>
						{categoryProjects.length > 0 ? (
							<div class="atlas-node-list">
								{categoryProjects.map((project) => (
									<a
										class="atlas-node-card"
										data-atlas-node
										data-touch-target="true"
										href={`/projects/${project.data.slug}/`}
										aria-label={`View project detail for ${project.data.name}`}
									>
										<span>{project.data.name}</span>
										<AudienceChips
											audiences={project.data.bestFor}
											label={`Best for ${project.data.name}`}
										/>
										<small>{project.data.proof}</small>
									</a>
								))}
							</div>
						) : (
							<p>
								This filter remains visible so the atlas taxonomy matches the
								planned capability model before every category has a public
								project.
							</p>
						)}
					</section>
				);
			})
		}
	</div>
</section>
