---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BuildTelemetryStrip from "../components/BuildTelemetryStrip.astro";
import CtaCluster from "../components/CtaCluster.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeScaffold } from "../lib/home-scaffold";

const scaffold = homeScaffold();
type ProjectEntry = CollectionEntry<"projects">;
const allProjects = (await getCollection("projects")) as ProjectEntry[];
const projects = allProjects
	.filter(
		(project: ProjectEntry) => project.data.publicationStatus === "publish",
	)
	.slice(0, 3);
---

<BaseLayout
	title="HumanKaylee | Systems Atelier"
	description="A static-first portfolio for practical AI-assisted systems, automation, infrastructure, backend services, and creative web work."
	canonicalPath="/"
>
	<section class="hero-shell" aria-labelledby="hero-title">
		<div class="hero-copy">
			<p class="section-kicker">{scaffold.kicker}</p>
			<h1 id="hero-title">{scaffold.heroTitle}</h1>
			<p class="lede">{scaffold.intro}</p>
			<p class="body-copy">{scaffold.noJsNote}</p>
			<CtaCluster items={scaffold.ctas} />
		</div>
		<aside class="paper-panel" aria-labelledby="atelier-note">
			<p class="eyebrow">Phase 2 static shell</p>
			<h2 id="atelier-note">Readable before the spectacle.</h2>
			<p>
				This page intentionally puts resume, projects, and contact paths ahead of
				interactive polish. The later systems map can impress without becoming a
				requirement for understanding the work.
			</p>
		</aside>
	</section>

	<BuildTelemetryStrip items={scaffold.telemetry} />

	<section class="content-section" aria-labelledby="paths-title">
		<p class="section-kicker">Audience paths</p>
		<h2 id="paths-title">Two fast reads, one evidence trail.</h2>
		<div class="path-grid">
			<article class="path-card">
				<p class="eyebrow">Recruiter path</p>
				<h3>Skills, scope, resume, contact.</h3>
				<p>
					A quick scan of practical strengths, current resume workflow, selected
					projects, and a direct fallback contact route.
				</p>
			</article>
			<article class="path-card">
				<p class="eyebrow">Engineer path</p>
				<h3>Architecture, verification, operations.</h3>
				<p>
					Project cards and case-study outlines emphasize constraints, evidence,
					and operational judgment over unsupported claims.
				</p>
			</article>
			<article class="path-card">
				<p class="eyebrow">Static baseline</p>
				<h3>No API dependency for core content.</h3>
				<p>
					The home page, project index, resume workflow, and contact page remain
					useful when JavaScript, WebGL, or the Rust API is unavailable.
				</p>
			</article>
		</div>
	</section>

	<section class="content-section" aria-labelledby="featured-projects">
		<p class="section-kicker">Featured projects</p>
		<h2 id="featured-projects">Selected proof without private leakage.</h2>
		<div class="artifact-grid">
			{projects.map((project: ProjectEntry) => <ProjectCard project={project} />)}
		</div>
	</section>
</BaseLayout>
