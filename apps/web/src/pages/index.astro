---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import EvidenceStrip from "../components/EvidenceStrip.astro";
import MediaFrame from "../components/MediaFrame.astro";
import ProjectStage from "../components/ProjectStage.astro";
import { routeInventoryById } from "../data/routes";
import BaseLayout from "../layouts/BaseLayout.astro";

type WorkEntry = CollectionEntry<"work">;
const allWork = (await getCollection("work")) as WorkEntry[];
const flagships = allWork
	.filter(
		(project) =>
			project.data.publicationStatus === "publish" &&
			typeof project.data.featuredOrder === "number",
	)
	.sort(
		(left, right) =>
			(left.data.featuredOrder ?? Number.POSITIVE_INFINITY) -
			(right.data.featuredOrder ?? Number.POSITIVE_INFINITY),
	);

if (flagships.length !== 3) {
	throw new Error(
		`Homepage requires exactly three published flagships; found ${flagships.length}.`,
	);
}

const cryogenicFlow = flagships[0];
---

<BaseLayout
	title="Joe Poznanski | Principal Engineer"
	description="Principal engineer for systems that cannot drift, from simulation and infrastructure to automation and recovery."
	canonicalPath="/"
	ogImage={routeInventoryById.home.seo.ogImage}
>
	<div class="signal-proof-home">
		<section class="home-hero" aria-labelledby="hero-title">
			<div class="home-hero__copy">
				<p class="section-kicker">Joe Poznanski · Principal Software Engineer</p>
				<h1 id="hero-title">Principal engineer for systems that cannot drift.</h1>
				<p class="home-hero__lede">
					I turn ambiguous operational problems into reliable software, from
					simulation and infrastructure to automation and recovery.
				</p>
				<a class="signal-link" data-touch-target="true" href="/work/">
					View selected work
				</a>
			</div>
			<div class="home-hero__media">
				<MediaFrame media={cryogenicFlow.data.media} />
			</div>
		</section>

		<EvidenceStrip
			items={cryogenicFlow.data.evidence.values}
			label="Verified Cryogenic Flow evidence"
		/>

		<ProjectStage projects={flagships} />

		<section class="home-capability" aria-labelledby="capability-title">
			<p class="section-kicker">Capabilities in practice</p>
			<h2 id="capability-title">
				Simulation fidelity, fleet consistency, and recovery judgment.
			</h2>
			<p>
				The common thread is operational trust: deterministic artifacts,
				account-local verification, and the smallest reversible recovery action.
			</p>
		</section>

		<section class="home-about" aria-labelledby="about-preview-title">
			<div>
				<p class="section-kicker">About</p>
				<h2 id="about-preview-title">Judgment lives in the handoff.</h2>
			</div>
			<div class="home-about__copy">
				<p>
					I work from problem framing through implementation, verification, and
					operator handoff. I value clear system boundaries, evidence that can be
					repeated, and documentation that preserves the reasoning behind a
					decision.
				</p>
				<a class="signal-link" data-touch-target="true" href="/about/">
					More about how I work
				</a>
			</div>
		</section>

		<section class="home-contact" aria-labelledby="contact-invitation-title">
			<p class="section-kicker">Start a conversation</p>
			<h2 id="contact-invitation-title">
				Working through a system where reliability matters?
			</h2>
			<a class="signal-link" data-touch-target="true" href="/contact/">
				Contact Joe
			</a>
		</section>
	</div>
</BaseLayout>

<style>
	.signal-proof-home {
		display: grid;
		gap: 0;
	}

	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(24rem, 1.05fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: center;
		min-height: min(44rem, calc(100vh - 8.5rem));
		padding-bottom: var(--space-6);
	}

	.home-hero__copy {
		display: grid;
		gap: var(--space-4);
		align-content: center;
	}

	.home-hero__copy .section-kicker,
	.home-capability .section-kicker,
	.home-about .section-kicker,
	.home-contact .section-kicker {
		color: var(--color-muted);
		font-size: 0.75rem;
	}

	.home-hero h1 {
		font-size: clamp(3.2rem, 6.6vw, 7rem);
	}

	.home-hero__lede {
		max-width: 40rem;
		font-size: clamp(1.05rem, 1.65vw, 1.4rem);
		line-height: 1.45;
	}

	.home-hero__media {
		min-width: 0;
	}

	.home-capability,
	.home-about,
	.home-contact {
		padding-block: var(--space-6);
	}

	.home-capability {
		display: grid;
		grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr) minmax(16rem, 0.55fr);
		gap: var(--space-4);
		align-items: start;
		border-block: 1px solid var(--line);
	}

	.home-capability h2 {
		font-size: clamp(2rem, 4.5vw, 4.5rem);
	}

	.home-capability > p:last-child {
		color: var(--color-muted);
	}

	.home-about {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.7fr);
		gap: clamp(2rem, 8vw, 10rem);
	}

	.home-about > div,
	.home-about__copy {
		display: grid;
		align-content: start;
		gap: var(--space-4);
	}

	.home-about__copy p {
		font-size: clamp(1.05rem, 1.7vw, 1.35rem);
		line-height: 1.55;
	}

	.home-contact {
		display: grid;
		grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 1fr) auto;
		gap: var(--space-4);
		align-items: end;
		border-top: 1px solid var(--line);
	}

	.home-contact h2 {
		max-width: 58rem;
		font-size: clamp(2.25rem, 5vw, 5rem);
	}

	@media (max-width: 64rem) {
		.home-hero,
		.home-capability,
		.home-about,
		.home-contact {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-hero {
			min-height: 0;
		}

		.home-contact {
			align-items: start;
		}
	}

	@media (max-width: 48rem) {
		.home-hero {
			gap: var(--space-5);
			padding-bottom: var(--space-5);
		}

		.home-hero h1 {
			font-size: clamp(2.8rem, 13vw, 4.3rem);
		}
	}
</style>
