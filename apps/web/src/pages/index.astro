---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BuildTelemetryStrip from "../components/BuildTelemetryStrip.astro";
import CtaCluster from "../components/CtaCluster.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SystemsMapHero from "../components/SystemsMapHero.astro";
import { routeInventoryById } from "../data/routes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeScaffold } from "../lib/home-scaffold";

const scaffold = homeScaffold();
type ProjectEntry = CollectionEntry<"projects">;
const allProjects = (await getCollection("projects")) as ProjectEntry[];
const [resume] = await getCollection("resume");
const projects = allProjects
	.filter(
		(project: ProjectEntry) => project.data.publicationStatus === "publish",
	)
	.slice(0, 3);
---

<BaseLayout
	title="Joe Poznanski | Systems Atelier"
	description="A static-first portfolio for practical AI-assisted systems, automation, infrastructure, backend services, and creative web work."
	canonicalPath="/"
	ogImage={routeInventoryById.home.seo.ogImage}
>
	<section class="hero-shell" aria-labelledby="hero-title">
		<div class="hero-copy">
			<p class="section-kicker">{scaffold.kicker}</p>
			<h1 id="hero-title">{scaffold.heroTitle}</h1>
			<p class="lede">{scaffold.intro}</p>
			<ul class="career-proof" aria-label="Career proof">
				<li><strong>15+ years</strong><span>shipping complex software</span></li>
				<li><strong>Principal engineer</strong><span>architecture through operations</span></li>
				<li><strong>Mission-critical</strong><span>aerospace and simulation delivery</span></li>
				<li><strong>Rust, C++, Python, AI</strong><span>systems and agent workflows</span></li>
			</ul>
			<p class="hero-note">{scaffold.noJsNote}</p>
			<CtaCluster items={scaffold.ctas} />
		</div>
		<SystemsMapHero projects={allProjects} />
	</section>

	<BuildTelemetryStrip items={scaffold.telemetry} />

	<section class="content-section home-evidence" aria-labelledby="support-title">
		<h2 id="support-title">Proof, before the details.</h2>
		<ol class="support-statement-list">
			{
				scaffold.supportStatements.map((statement) => (
					<li>
						<span>{statement}</span>
					</li>
				))
			}
		</ol>
	</section>

	<section class="content-section home-audience" aria-labelledby="paths-title">
		<h2 id="paths-title">Start with the view you need.</h2>
		<div class="path-grid">
			<article class="path-card home-recruiter-path">
				<p class="eyebrow">Recruiter path</p>
				<h3>Skills, scope, resume, contact.</h3>
				<p>
					A focused view of experience, practical strengths, selected projects,
					and a direct contact route.
				</p>
				<a
					class="contact-link"
					data-touch-target="true"
					href={resume.data.pdfDownloadPath}
				>
					Download resume PDF
				</a>
			</article>
			<article class="path-card home-engineer-path">
				<p class="eyebrow">Engineer path</p>
				<h3>Architecture, verification, operations.</h3>
				<p>
					Project cards and case-study outlines emphasize constraints, evidence,
					and operational judgment over unsupported claims.
				</p>
			</article>
		</div>
	</section>

	<section
		class="content-section interface-evidence"
		aria-labelledby="interface-evidence-title"
		aria-label="Selected interface evidence"
	>
		<div class="section-heading-row">
			<div>
				<p class="section-kicker">Interface evidence</p>
				<h2 id="interface-evidence-title">The system is visible.</h2>
			</div>
			<p>Two public-safe views from the portfolio itself: capability mapping and project navigation.</p>
		</div>
		<div class="interface-evidence-grid">
			<figure class="interface-proof-window">
				<div class="proof-window-bar" aria-hidden="true"><span></span><span></span><span></span><small>systems-map</small></div>
				<svg viewBox="0 0 640 360" role="img" aria-labelledby="systems-proof-title systems-proof-description">
					<title id="systems-proof-title">Systems map interface</title>
					<desc id="systems-proof-description">A visual map connecting problem framing, system architecture, and verification evidence.</desc>
					<rect width="640" height="360" rx="24" class="proof-canvas"></rect>
					<path d="M120 190 L270 90 L490 140 L420 280 L190 285 Z" class="proof-thread"></path>
					<circle cx="320" cy="190" r="62" class="proof-core"></circle>
					<text x="320" y="184" text-anchor="middle" class="proof-core-title">JP</text>
					<text x="320" y="210" text-anchor="middle" class="proof-core-label">evidence core</text>
					<g class="proof-nodes"><circle cx="120" cy="190" r="13"></circle><circle cx="270" cy="90" r="13"></circle><circle cx="490" cy="140" r="13"></circle><circle cx="420" cy="280" r="13"></circle><circle cx="190" cy="285" r="13"></circle></g>
				</svg>
				<figcaption><strong>Systems map</strong><span>Architecture and evidence stay connected.</span></figcaption>
			</figure>
			<figure class="interface-proof-window">
				<div class="proof-window-bar" aria-hidden="true"><span></span><span></span><span></span><small>project-atlas</small></div>
				<svg viewBox="0 0 640 360" role="img" aria-labelledby="atlas-proof-title atlas-proof-description">
					<title id="atlas-proof-title">Project atlas interface</title>
					<desc id="atlas-proof-description">A project navigation view with capability clusters and direct evidence routes.</desc>
					<rect width="640" height="360" rx="24" class="proof-canvas proof-canvas-alt"></rect>
					<path d="M115 250 C210 100 420 90 535 220" class="proof-thread proof-thread-alt"></path>
					<g class="proof-atlas-cards">
						<rect x="70" y="195" width="150" height="82" rx="15"></rect>
						<rect x="245" y="70" width="150" height="82" rx="15"></rect>
						<rect x="420" y="175" width="150" height="82" rx="15"></rect>
					</g>
					<g class="proof-atlas-labels"><text x="145" y="230" text-anchor="middle">operations</text><text x="320" y="105" text-anchor="middle">automation</text><text x="495" y="210" text-anchor="middle">creative web</text></g>
				</svg>
				<figcaption><strong>Project atlas</strong><span>Capability clusters open direct project routes.</span></figcaption>
			</figure>
		</div>
	</section>

	<section class="content-section home-projects" aria-labelledby="featured-projects">
		<h2 id="featured-projects">Selected work, with public-safe evidence.</h2>
		<div class="artifact-grid home-project-grid">
			{
				projects.map((project: ProjectEntry, index) => (
					<ProjectCard
						project={project}
						className={index === 0 ? "home-featured-project" : undefined}
					/>
				))
			}
		</div>
	</section>
</BaseLayout>
