---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import EvidenceDrawer from "../../components/EvidenceDrawer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

type CaseStudy = CollectionEntry<"caseStudies">;

export async function getStaticPaths() {
	const caseStudies = (
		(await getCollection("caseStudies")) as CaseStudy[]
	).filter((caseStudy) => caseStudy.data.publicationStatus === "publish");

	return caseStudies.map((caseStudy) => ({
		params: { slug: caseStudy.data.slug },
		props: { caseStudy },
	}));
}

type Props = {
	caseStudy: CaseStudy;
};

const { caseStudy } = Astro.props as Props;
const {
	title,
	category,
	summary,
	problem,
	stakes,
	constraints,
	architecture,
	implementation,
	verification,
	operations,
	outcome,
	lessons,
	links,
	redactionStatus,
	seo,
} = caseStudy.data;
const constraintItems: string[] = constraints;
const implementationItems: string[] = implementation;
const verificationItems: string[] = verification;
const operationItems: string[] = operations;
const lessonItems: string[] = lessons;
const safeArtifacts: string[] = links?.artifacts ?? [];
const architectureMapItems = [
	{
		label: "Context",
		value: architecture.overview,
	},
	{
		label: "Constraint",
		value: constraintItems[0],
	},
	{
		label: "Verification",
		value: verificationItems[0],
	},
	{
		label: "Release boundary",
		value: `Current public content remains ${redactionStatus}; this map is sanitized presentation, not production approval.`,
	},
];
const { Content } = await render(caseStudy);
const [site] = await getCollection("site");
const siteUrl = site.data.siteUrl.replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${seo.canonicalPath}`;
const structuredData = {
	"@context": "https://schema.org",
	"@type": "CreativeWork",
	name: title,
	description: summary,
	url: canonicalUrl,
	genre: category,
	keywords: [category, ...caseStudy.data.audienceFit],
};
---

<BaseLayout
	title={`${seo.title} | Joe Poznanski`}
	description={seo.description}
	canonicalPath={seo.canonicalPath}
	ogImage={seo.ogImage}
	structuredData={structuredData}
>
	<article class="case-study-detail" aria-labelledby="case-study-title">
		<header class="page-header">
			<p class="section-kicker">{category} case study</p>
			<h1 id="case-study-title">{title}</h1>
			<p class="page-intro">{summary}</p>
		</header>

		<section class="case-study-section" aria-labelledby="problem-title">
			<h2 id="problem-title">Problem</h2>
			<p>{problem}</p>
			<p>{stakes}</p>
		</section>

		<section class="case-study-section" aria-labelledby="constraints-title">
			<h2 id="constraints-title">Constraints</h2>
			<ul>
				{constraintItems.map((constraint) => <li>{constraint}</li>)}
			</ul>
		</section>

		<section class="case-study-section" aria-labelledby="architecture-title">
			<h2 id="architecture-title">Architecture</h2>
			<p>{architecture.overview}</p>
			<figure class="text-diagram" aria-label={architecture.diagramAlt}>
				<figcaption>
					<p class="eyebrow">Public-safe architecture map</p>
					<p>{architecture.diagramAlt}</p>
				</figcaption>
				<dl class="architecture-map">
					{
						architectureMapItems.map((item) => (
							<div class="architecture-node">
								<dt>{item.label}</dt>
								<dd>{item.value}</dd>
							</div>
						))
					}
				</dl>
			</figure>
		</section>

		<section class="case-study-section" aria-labelledby="implementation-title">
			<h2 id="implementation-title">Implementation</h2>
			<ul>
				{implementationItems.map((detail) => <li>{detail}</li>)}
			</ul>
		</section>

		<section class="case-study-section" aria-labelledby="verification-title">
			<h2 id="verification-title">Verification</h2>
			<ul>
				{verificationItems.map((check) => <li>{check}</li>)}
			</ul>
		</section>

		<section class="case-study-section" aria-labelledby="operations-title">
			<h2 id="operations-title">Operations</h2>
			<ul>
				{operationItems.map((note) => <li>{note}</li>)}
			</ul>
		</section>

		<section class="case-study-section" aria-labelledby="outcome-title">
			<h2 id="outcome-title">Outcome</h2>
			<p>{outcome}</p>
		</section>

		<section class="case-study-section" aria-labelledby="lessons-title">
			<h2 id="lessons-title">Lessons</h2>
			<ul>
				{lessonItems.map((lesson) => <li>{lesson}</li>)}
			</ul>
		</section>

		<section class="case-study-section" aria-labelledby="safe-links-title">
			<h2 id="safe-links-title">Safe links and artifacts</h2>
			{
				safeArtifacts.length > 0 ? (
					<ul>
						{safeArtifacts.map((artifact) => (
							<li>{artifact}</li>
						))}
					</ul>
				) : (
					<p>No public-safe artifact labels are attached yet.</p>
				)
			}
		</section>

		<section class="case-study-section case-study-body" aria-label="Case study body">
			<Content />
		</section>

		<EvidenceDrawer caseStudy={caseStudy} />
	</article>
</BaseLayout>
