---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

type NoteEntry = CollectionEntry<"notes">;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});

const notes = ((await getCollection("notes")) as NoteEntry[])
	.filter((note: NoteEntry) => note.data.publicationStatus === "publish")
	.sort((left: NoteEntry, right: NoteEntry) =>
		right.data.publishedAt.localeCompare(left.data.publishedAt),
	);
---

<BaseLayout
	title="Notes and Build Log | HumanKaylee"
	description="Published engineering notes and build-log entries from HumanKaylee's static-first portfolio."
	canonicalPath="/notes/"
>
	<section class="page-shell" aria-labelledby="notes-title">
		<header class="page-header">
			<p class="section-kicker">Notes / build log</p>
			<h1 id="notes-title">Notes from the systems atelier.</h1>
			<p class="page-intro">
				Short public-safe write-ups about portfolio architecture, publication
				boundaries, and build decisions. Every entry is rendered from the notes
				content collection and stays useful without JavaScript.
			</p>
		</header>

		<div class="artifact-grid">
			{
				notes.map((note: NoteEntry) => (
					<article class="project-card" aria-labelledby={`${note.data.slug}-title`}>
						<p class="project-category">
							<time datetime={note.data.publishedAt}>
								{dateFormatter.format(new Date(`${note.data.publishedAt}T00:00:00Z`))}
							</time>
						</p>
						<h2 id={`${note.data.slug}-title`}>{note.data.title}</h2>
						<p class="body-copy">{note.data.summary}</p>
						<ul class="note-tags" aria-label={`${note.data.title} tags`}>
							{note.data.tags.map((tag: string) => <li>{tag}</li>)}
						</ul>
						<a
							data-touch-target="true"
							href={`/notes/${note.data.slug}/`}
							aria-label={note.data.title}
						>
							Read note
						</a>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
