---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

const [resume] = await getCollection("resume");
const data = resume.data;
type WorkflowStep = (typeof data.workflowSteps)[number];
---

<BaseLayout
	title="Resume | HumanKaylee"
	description="HTML resume entry point and PDF source workflow for HumanKaylee."
	canonicalPath="/resume/"
>
	<section class="page-shell" aria-labelledby="resume-title">
		<header class="page-header">
			<p class="section-kicker">Resume</p>
			<h1 id="resume-title">Resume path with a published PDF.</h1>
			<p class="page-intro">
				The downloadable resume PDF is available as a static asset, keeping the
				recruiter path fast and independent of JavaScript, WebGL, or API uptime.
			</p>
		</header>

		<article class="paper-panel">
			<p class="eyebrow">Published resume</p>
			<h2>{data.title}</h2>
			<p>
				Source status: {data.sourceStatus}. Approval state: {data.approvalState}.
				The public PDF is served from {data.pdfDownloadPath}.
			</p>
			<a
				class="contact-link"
				data-touch-target="true"
				href={data.pdfDownloadPath}
			>
				Download resume PDF
			</a>
			<ul class="workflow-list">
				{
					data.workflowSteps.map((step: WorkflowStep) => (
						<li>
							<span>{step.step}</span>
							<strong>{step.status}</strong>
						</li>
					))
				}
			</ul>
		</article>
	</section>
</BaseLayout>
