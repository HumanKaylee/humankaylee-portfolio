---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

const [resume] = await getCollection("resume");
const data = resume.data;
type WorkflowStep = (typeof data.workflowSteps)[number];
---

<BaseLayout
	title={`${data.seo.title} | HumanKaylee`}
	description={data.seo.description}
	canonicalPath={data.seo.canonicalPath}
	ogImage={data.seo.ogImage}
	bodyClass="resume-print-route"
>
	<section class="page-shell" aria-labelledby="resume-title">
		<header class="page-header resume-screen-header">
			<p class="section-kicker">Resume</p>
			<h1 id="resume-title">Resume path with a static PDF asset.</h1>
			<p class="page-intro">
				The downloadable resume PDF is served as a static asset from the
				approved local source, keeping the recruiter path fast and independent
				of JavaScript, WebGL, or API uptime.
			</p>
		</header>

		<article class="paper-panel resume-print-sheet" data-print-resume="true">
			<p class="eyebrow">Static resume asset</p>
			<h2>{data.title}</h2>
			<p>
				Source status: {data.sourceStatus}. Local source approval state:{" "}
				{data.approvalState}. The downloadable PDF is served from{" "}
				{data.pdfDownloadPath}.
			</p>
			<a
				class="contact-link"
				data-touch-target="true"
				href={data.pdfDownloadPath}
			>
				Download resume PDF
			</a>
			<ul class="workflow-list">
				{
					data.workflowSteps.map((step: WorkflowStep) => (
						<li>
							<span>{step.step}</span>
							<strong>{step.status}</strong>
						</li>
					))
				}
			</ul>
		</article>
	</section>
</BaseLayout>
