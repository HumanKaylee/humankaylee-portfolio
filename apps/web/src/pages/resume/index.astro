---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

const [resume] = await getCollection("resume");
const data = resume.data;

const contact = {
	title:
		"Principal Software Engineer - Agentic AI Systems / LLM Platform Engineering",
	location: "Titusville, Florida, USA",
	email: "josephpoznanski@gmail.com",
	linkedin: "linkedin.com/in/joe-poznanski",
	linkedinUrl: "https://www.linkedin.com/in/joe-poznanski",
	certs: "PMP · PMI-ACP",
};

const summary =
	"Principal Software Engineer with 15+ years shipping mission-critical aerospace and high-fidelity simulation software (Otto Aerospace, Blue Origin). I build agentic AI systems and developer automation that turn ambiguous operational goals into reliable, test-backed software: tool-using agents, eval/guardrail pipelines, and self-healing workflows that accelerate requirements-to-code while improving safety and correctness. Deep hands-on delivery across Rust / C / C++ / Python, distributed systems, and operator-grade dashboards.";

const highlights = [
	"Built tool-using agent workflows that automate triage to plan to implementation loops with human-in-the-loop review. The result is repeatable, test-backed changes instead of one-off prompt outputs.",
	"Created AI-assisted QA pipelines (test scaffolds, evidence packaging, regression summaries) that shorten feedback cycles on safety- and mission-critical systems.",
	"Developed ops copilots for log/telemetry summarization and anomaly correlation across distributed services, cutting time-to-diagnosis during integration and drills.",
	"Standardized prompt/playbook libraries and deterministic guardrails so teams can adopt AI workflows safely at scale.",
];

const experience = [
	{
		company: "Otto Aerospace",
		place: "Ft. Worth, TX",
		role: "Principal Software Engineer - SuperNatural Vision Program",
		dates: "Aug 2025 - Present",
		bullets: [
			"Architected and shipped an 8K video-wall system: synchronized playback across a 4-node Mac Mini cluster (~50 GB/s aggregate) with sub-frame latency, driving immersive executive demos.",
			"Built a Rust/tokio orchestration backend (async SSH dispatch, JSON-RPC playback control) with <100 ms command round-trip; and a Node.js/React operator dashboard with <16 ms UI updates.",
			"Operationalized agentic AI workflows (Claude/Codex + tool-use) for triage, code-gen, and refactoring across Rust/Python/Node. The resulting changes are reviewable, test-backed, and wired into CI/CD.",
		],
	},
	{
		company: "Blue Origin",
		place: "Cape Canaveral, FL",
		role: "Senior Simulation / Aerospace Operations Software Engineer",
		dates: "May 2022 - Aug 2025",
		bullets: [
			"Invented a Rust-based “Simulated Avionics Layer” streaming 500k+ telemetry signals (~5 GB/s) from a single server, cutting hardware spend $1.2M and integration labor 60%.",
			"Automated test & compliance: Python/pytest + GitLab CI running 800+ unit/functional/HIL tests nightly, auto-generating DO-178C / AS9100 evidence; regression cycles 3 days → 2 hours.",
			"Shipped the first-gen Operations Training Simulator (MVP in 18 months); trainee setup time −70%, NPS 93/100.",
		],
	},
	{
		company: "Avenger Flight Group",
		place: "Dallas, TX / Las Vegas, NV",
		role: "Director of Simulation & Software Engineering",
		dates: "Jun 2014 - May 2022",
		bullets: [
			"Scaled the company 11 → 200+ staff across three countries; hired and mentored the first 30 simulation/software engineers.",
			"Designed a real-time C++17 / VxWorks / ZeroMQ data-bus (<120 ms) now fielded on 18+ aircraft simulators; earned 100% first-pass FAA approvals via CI/CD + automated DO-178C artifacts.",
			"Led technical delivery of a $45M multi-year simulator refresh (A320, 737 MAX, ATR), lifting narrow-body market share 1% → 13%.",
		],
	},
	{
		company: "SIMCOM Training",
		place: "Orlando, FL",
		role: "Flight Simulation Supervisor & Project Manager",
		dates: "Feb 2011 - Jun 2014",
		bullets: [
			"Built an enterprise C++/SQL analytics platform ingesting Qualification Test Guide data from 12 flight-training devices, auto-generating compliance logs.",
		],
	},
];

const skillGroups = [
	{
		label: "Languages",
		items:
			"Rust · C · C++ (17/20) · Python · Java · TypeScript/JS · SQL · Bash · PowerShell",
	},
	{
		label: "AI / ML",
		items:
			"Agentic systems & multi-agent orchestration · tool-using agents · evals/guardrails · Claude · OpenAI/Codex · PyTorch · TensorFlow",
	},
	{
		label: "Systems & Tooling",
		items:
			"tokio · Boost · Docker · GitLab/Jenkins CI/CD · AWS · Terraform · Ansible · Linux/RT · Grafana/Loki · React · Node.js",
	},
	{
		label: "Aerospace & Standards",
		items:
			"DO-178B/C · AS9100 · ARP4754A/4761 · FAA Part 60 · MBSE · HIL simulation · DAL-A/E",
	},
];

const clearance =
	"U.S. Citizen · active DBIDS badge (Cape Canaveral) · eligible for U.S. Secret / Top Secret clearance · able to travel up to 50%.";
---

<BaseLayout
	title={`${data.seo.title} | Joe Poznanski`}
	description="Joe Poznanski: Principal Software Engineer for agentic AI and aerospace simulation. Summary, highlights, experience, and a downloadable PDF."
	canonicalPath={data.seo.canonicalPath}
	ogImage={data.seo.ogImage}
	bodyClass="resume-print-route"
>
	<section class="page-shell resume-page" aria-labelledby="resume-title">
		<header class="page-header resume-hero">
			<p class="section-kicker">Resume</p>
			<h1 id="resume-title">Joe Poznanski</h1>
			<p class="resume-subtitle">{contact.title}</p>
			<ul class="resume-meta-list" aria-label="Contact and credentials">
				<li>{contact.location}</li>
				<li>{contact.certs}</li>
				<li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
				<li><a href={contact.linkedinUrl} rel="me">{contact.linkedin}</a></li>
			</ul>
			<div class="resume-actions">
				<a class="resume-download" data-touch-target="true" href={data.pdfDownloadPath} download>Download full resume (PDF)</a>
				<span class="resume-clearance-chip">Secret / Top-Secret eligible</span>
			</div>
			<nav class="section-jump-nav resume-section-nav" aria-label="Resume sections">
				<a data-touch-target="true" href="#summary">Summary</a>
				<a data-touch-target="true" href="#highlights">AI and automation</a>
				<a data-touch-target="true" href="#experience">Experience</a>
				<a data-touch-target="true" href="#skills">Skills</a>
			</nav>
		</header>

		<article class="paper-panel resume-print-sheet" data-print-resume="true">
			<section class="resume-section" id="summary">
				<h2>Summary</h2>
				<p class="resume-summary">{summary}</p>
			</section>

			<section class="resume-section" id="highlights">
				<h2>Agentic AI &amp; automation highlights</h2>
				<ul class="resume-bullets">
					{highlights.map((h) => <li>{h}</li>)}
				</ul>
			</section>

			<section class="resume-section" id="experience">
				<h2>Experience</h2>
				<div class="resume-experience">
					{experience.map((job) => (
						<div class="resume-job">
							<div class="resume-job-head">
								<div>
									<p class="resume-job-company">{job.company} <span class="resume-job-place">· {job.place}</span></p>
									<p class="resume-job-role">{job.role}</p>
								</div>
								<p class="resume-job-dates">{job.dates}</p>
							</div>
							<ul class="resume-bullets">
								{job.bullets.map((b) => <li>{b}</li>)}
							</ul>
						</div>
					))}
				</div>
			</section>

			<section class="resume-section" id="skills">
				<h2>Technical skills</h2>
				<dl class="resume-skills">
					{skillGroups.map((g) => (
						<div class="resume-skill-row">
							<dt>{g.label}</dt>
							<dd>{g.items}</dd>
						</div>
					))}
				</dl>
			</section>

			<section class="resume-section resume-clearance">
				<h2>Clearance</h2>
				<p>{clearance}</p>
			</section>
		</article>
	</section>
</BaseLayout>

<style>
	.resume-hero { max-width: 1020px; }
	.resume-hero h1 { margin-bottom: 0.25rem; }
	.resume-subtitle { font-size: 1.1rem; font-weight: 600; opacity: 0.92; margin: 0.25rem 0 0.5rem; }
	.resume-meta-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.85rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		opacity: 0.8;
	}
	.resume-meta-list li:not(:last-child)::after {
		content: "·";
		margin-left: 0.85rem;
	}
	.resume-meta-list a {
		align-items: center;
		color: inherit;
		display: inline-flex;
		min-height: 44px;
		padding-inline: 0.2rem;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.resume-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; margin-top: 1.25rem; }
	.resume-download {
		display: inline-block; padding: 0.7rem 1.3rem; border-radius: 999px;
		background: #f4ecd8; color: #14110c; font-weight: 700; text-decoration: none;
	}
	.resume-clearance-chip {
		font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase;
		padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid rgba(120,150,120,0.5);
		color: #9ec49a;
	}
	.resume-section { margin-bottom: 2rem; }
	.resume-section:last-child { margin-bottom: 0; }
	.resume-section h2 {
		font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase;
		opacity: 0.65; margin-bottom: 0.85rem; border-bottom: 1px solid rgba(0,0,0,0.12); padding-bottom: 0.4rem;
	}
	.resume-summary { font-size: 1.05rem; line-height: 1.7; }
	.resume-bullets { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.5rem; }
	.resume-bullets li { line-height: 1.55; }
	.resume-experience { display: grid; gap: 1.6rem; }
	.resume-job-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.55rem; flex-wrap: wrap; }
	.resume-job-company { font-weight: 700; font-size: 1.05rem; }
	.resume-job-place { font-weight: 400; opacity: 0.7; }
	.resume-job-role { font-size: 0.95rem; opacity: 0.85; }
	.resume-job-dates { font-size: 0.85rem; opacity: 0.65; white-space: nowrap; font-variant-numeric: tabular-nums; }
	.resume-skills { display: grid; gap: 0.7rem; margin: 0; }
	.resume-skill-row { display: grid; grid-template-columns: 180px 1fr; gap: 1rem; }
	.resume-skill-row dt { font-weight: 700; font-size: 0.9rem; }
	.resume-skill-row dd { margin: 0; opacity: 0.85; line-height: 1.5; }
	@media (max-width: 640px) {
		.resume-skill-row { grid-template-columns: 1fr; gap: 0.25rem; }
		.resume-job-dates { white-space: normal; }
		.resume-meta-list { display: grid; gap: 0.1rem; }
		.resume-meta-list li:not(:last-child)::after { content: none; }
	}
</style>
