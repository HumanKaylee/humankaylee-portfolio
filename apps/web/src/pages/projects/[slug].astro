---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

type ProjectEntry = CollectionEntry<"projects">;
type CaseStudyEntry = CollectionEntry<"caseStudies">;

export async function getStaticPaths() {
	const projects = ((await getCollection("projects")) as ProjectEntry[]).filter(
		(project) => project.data.publicationStatus === "publish",
	);

	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

type Props = {
	project: ProjectEntry;
};

const { project } = Astro.props as Props;
const { data } = project;
const relatedCaseStudySlug = data.links?.docs?.match(
	/^\/case-studies\/([^/]+)\/$/,
)?.[1];
const publishedCaseStudies = (
	(await getCollection("caseStudies")) as CaseStudyEntry[]
).filter((caseStudy) => caseStudy.data.publicationStatus === "publish");
const relatedCaseStudy = publishedCaseStudies.find(
	(caseStudy) => caseStudy.data.slug === relatedCaseStudySlug,
);
const relatedCaseStudyTitle = relatedCaseStudy?.data.title ?? data.name;
const projectProblem =
	relatedCaseStudy?.data.problem ??
	"A bounded systems problem with operational constraints.";
const projectOutcome = relatedCaseStudy?.data.outcome ?? data.proof;
const architectureOverview =
	relatedCaseStudy?.data.architecture.overview ??
	"A small, inspectable system that keeps public evidence separate from private operational context.";
const verificationEvidence = relatedCaseStudy?.data.verification ?? [
	data.proof,
];
const [site] = await getCollection("site");
const siteUrl = site.data.siteUrl.replace(/\/$/, "");
const canonicalUrl = `${siteUrl}${data.seo.canonicalPath}`;
const structuredData = {
	"@context": "https://schema.org",
	"@type": "SoftwareSourceCode",
	name: data.name,
	description: data.summary,
	url: canonicalUrl,
	applicationCategory: data.category,
	about: data.bestFor,
};
---

<BaseLayout
	title={`${data.seo.title} | Joe Poznanski`}
	description={data.seo.description}
	canonicalPath={data.seo.canonicalPath}
	ogImage={data.seo.ogImage}
	structuredData={structuredData}
>
	<article class="case-study-detail project-detail" aria-labelledby="project-detail-title">
		<header class="page-header">
			<p class="section-kicker">Project detail</p>
			<h1 id="project-detail-title">{data.name}</h1>
			<p class="page-intro">{data.summary}</p>
			<div class="detail-actions">
				<a data-touch-target="true" href="/projects/" aria-label="Back to project atlas">
					Back to project atlas
				</a>
				{data.links?.docs ? (
					<a class="detail-primary-action" data-touch-target="true" href={data.links.docs}>
						Read the full case study
					</a>
				) : null}
			</div>
		</header>

		<section class="case-study-section project-glance" aria-labelledby="project-glance-title">
			<h2 id="project-glance-title">Project at a glance</h2>
			<dl class="project-glance-grid">
				<div><dt>Challenge</dt><dd>{projectProblem}</dd></div>
				<div><dt>Role</dt><dd>Principal engineer, architecture through verification</dd></div>
				<div><dt>Capability</dt><dd>{data.category}</dd></div>
				<div><dt>Outcome</dt><dd>{projectOutcome}</dd></div>
			</dl>
		</section>

		<section class="case-study-section" aria-labelledby="architecture-flow-title">
			<h2 id="architecture-flow-title">Architecture flow</h2>
			<ol class="architecture-flow" aria-label="Project architecture flow">
				<li><span>01</span><div><strong>Frame the operational problem</strong><p>{projectProblem}</p></div></li>
				<li><span>02</span><div><strong>Build the smallest durable system</strong><p>{architectureOverview}</p></div></li>
				<li><span>03</span><div><strong>Verify and hand off</strong><p>{data.proof}</p></div></li>
			</ol>
		</section>

		<section class="case-study-section" aria-labelledby="verification-evidence-title">
			<h2 id="verification-evidence-title">Verification evidence</h2>
			<ul>
				{verificationEvidence.map((evidence: string) => <li>{evidence}</li>)}
			</ul>
		</section>

		{data.links?.docs ? (
			<section class="case-study-section" aria-labelledby="related-case-study-title">
				<h2 id="related-case-study-title">Continue into the case study</h2>
				<p>
					Read the full narrative for constraints, implementation decisions,
					operations, and lessons.
				</p>
				<a
					data-touch-target="true"
					href={data.links.docs}
					aria-label={`Read the full case study: ${relatedCaseStudyTitle}`}
				>
					Read the full case study: {relatedCaseStudyTitle}
				</a>
			</section>
		) : null}
	</article>
</BaseLayout>
