---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import ProjectAtlas from "../../components/ProjectAtlas.astro";
import { routeInventoryById } from "../../data/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";

type ProjectEntry = CollectionEntry<"projects">;
const projects = ((await getCollection("projects")) as ProjectEntry[]).filter(
	(project: ProjectEntry) => project.data.publicationStatus === "publish",
);
const categories = [
	...new Set(projects.map((project: ProjectEntry) => project.data.category)),
].sort();
---

<BaseLayout
	title="Project Atlas | Joe Poznanski"
	description="A static project atlas for Joe Poznanski's automation, operations, backend, and creative web systems."
	canonicalPath="/projects/"
	ogImage={routeInventoryById.projects.seo.ogImage}
>
	<section class="page-shell" aria-labelledby="projects-title">
		<header class="page-header">
			<p class="section-kicker">Project atlas</p>
			<h1 id="projects-title">Selected systems, mapped by capability.</h1>
			<p class="page-intro">
				Automation, operations, and creative web work presented through the
				problem, architecture, verification, and outcome.
			</p>
			<ul class="project-taxonomy" aria-label="Published project categories">
				{categories.map((category) => <li>{category}</li>)}
			</ul>
		</header>

		<ProjectAtlas projects={projects} />
	</section>
</BaseLayout>
