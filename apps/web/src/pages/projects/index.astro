---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

type ProjectEntry = CollectionEntry<"projects">;
const projects = ((await getCollection("projects")) as ProjectEntry[]).filter(
	(project: ProjectEntry) => project.data.publicationStatus === "publish",
);
const categories = [
	...new Set(projects.map((project: ProjectEntry) => project.data.category)),
];
---

<BaseLayout
	title="Project Atlas | HumanKaylee"
	description="A static project atlas for HumanKaylee's automation, operations, backend, and creative web systems."
	canonicalPath="/projects/"
>
	<section class="page-shell" aria-labelledby="projects-title">
		<header class="page-header">
			<p class="section-kicker">Project atlas</p>
			<h1 id="projects-title">Project atlas for practical systems work.</h1>
			<p class="page-intro">
				CLI Fleet Synchronization, remote workstation recovery, and the
				portfolio build itself are represented as accessible cards first. Later
				interactive maps will consume the same static collection data.
			</p>
		</header>

		<aside class="paper-panel" aria-label="Project categories">
			<p class="eyebrow">Taxonomy</p>
			<p class="body-copy">{categories.join(" / ")}</p>
		</aside>

		<div class="artifact-grid">
			{projects.map((project: ProjectEntry) => <ProjectCard project={project} />)}
		</div>
	</section>
</BaseLayout>
