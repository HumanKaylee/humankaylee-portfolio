---
import ContactForm from "../../components/ContactForm.astro";
import { routeInventoryById } from "../../data/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Contact | HumanKaylee"
	description="API-enhanced contact route with a visible mailto fallback for recruiter and project inquiries."
	canonicalPath="/contact/"
	ogImage={routeInventoryById.contact.seo.ogImage}
>
	<section class="page-shell" aria-labelledby="contact-title">
		<header class="page-header">
			<p class="section-kicker">Contact</p>
			<h1 id="contact-title">Contact route with API enhancement and fallback.</h1>
			<p class="page-intro">
				Send a concise recruiter, collaborator, or project note. The form
				enhances through the Rust API when available, while the mailto path
				remains visible if JavaScript or the backend is unavailable.
			</p>
		</header>

		<ContactForm />
	</section>
</BaseLayout>
