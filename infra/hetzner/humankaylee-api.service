[Unit]
Description=HumanKaylee Portfolio API (Axum)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=humankaylee
Group=humankaylee
WorkingDirectory=/opt/humankaylee-api
ExecStart=/opt/humankaylee-api/humankaylee-api
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

Environment="RUST_LOG=info,humankaylee_api=debug"
Environment="HK_API_HOST=0.0.0.0"
Environment="HK_API_PORT=8080"
Environment="HK_API_ALLOWED_ORIGINS=https://humankaylee.dev"
Environment="HK_API_CONTACT_DELIVERY_MODE=store"
Environment="HK_API_CONTACT_STORE_PATH=/opt/humankaylee-api/data/contacts.jsonl"
EnvironmentFile=-/etc/humankaylee-api.env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/humankaylee-api/data

[Install]
WantedBy=multi-user.target
